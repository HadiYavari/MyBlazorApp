<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="MyBlazorApp.Core\MyBlazorApp.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sibling projects live under this directory; exclude their files from this project's own globbing. -->
    <Compile Remove="MyBlazorApp.Core\**\*.cs" />
    <Compile Remove="MyBlazorApp.Core.Tests\**\*.cs" />
    <Content Remove="MyBlazorApp.Core\**\*" />
    <Content Remove="MyBlazorApp.Core.Tests\**\*" />
    <None Remove="MyBlazorApp.Core\**\*" />
    <None Remove="MyBlazorApp.Core.Tests\**\*" />
  </ItemGroup>

</Project>

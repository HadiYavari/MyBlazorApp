@page "/"
@using MyBlazorApp.Core
@using MyBlazorApp.Services
@inject CalculatorStateService State

<PageTitle>Calculator</PageTitle>

<div class="calculator">
    <h1>Calculator</h1>

    <div class="input-row">
        <input type="number" class="number-input" @bind="State.FirstNumber" @bind:event="oninput" placeholder="First number" />
        <input type="number" class="number-input" @bind="State.SecondNumber" @bind:event="oninput" placeholder="Second number" />
    </div>

    <div class="operation-row">
        <button class="op-button @(State.SelectedOperation == CalculatorOperation.Add ? "selected" : "")" @onclick="() => State.SelectOperation(CalculatorOperation.Add)">+</button>
        <button class="op-button @(State.SelectedOperation == CalculatorOperation.Subtract ? "selected" : "")" @onclick="() => State.SelectOperation(CalculatorOperation.Subtract)">-</button>
        <button class="op-button @(State.SelectedOperation == CalculatorOperation.Multiply ? "selected" : "")" @onclick="() => State.SelectOperation(CalculatorOperation.Multiply)">*</button>
        <button class="op-button @(State.SelectedOperation == CalculatorOperation.Divide ? "selected" : "")" @onclick="() => State.SelectOperation(CalculatorOperation.Divide)">/</button>
    </div>

    <button class="equals-button" @onclick="State.Calculate">=</button>

    @if (State.Result is not null)
    {
        <div class="result">Result: @State.Result</div>
    }
    else if (State.ErrorMessage is not null)
    {
        <div class="error">@State.ErrorMessage</div>
    }
</div>
